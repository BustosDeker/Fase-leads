# =====================================================================
# INBESTIGA · Fase LEADS — configuración local
# `npm run setup` copia este archivo a .env y genera los secretos vacíos
# marcados con (auto). NUNCA subas .env al repositorio.
# =====================================================================

# --- Aplicación --------------------------------------------------------
PORT=3100
OPEN_BROWSER=true
# (auto) firma de las cookies de sesión
SESSION_SECRET=
# Usuarios de la UI: usuario:clave:rol separados por coma. Roles: admin, asesor, viewer.
# Cámbialos antes de una demo pública.
APP_USERS=admin:admin123:admin,asesor:asesor123:asesor,docente:docente123:viewer

# --- SQL Server (instalación nativa, sin Docker) -----------------------
DB_SERVER=localhost
DB_PORT=1433
# Solo si usas una instancia con nombre (p. ej. SQLEXPRESS) y SQL Server Browser está activo:
DB_INSTANCE=
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
# Usuario de la app con mínimos privilegios (lo crea `npm run db:init`)
DB_USER=inbestiga_app
# (auto)
DB_PASSWORD=
# Administrador: SOLO lo usa `npm run db:init` / `npm run seed` para crear bases y usuarios
DB_ADMIN_USER=sa
DB_ADMIN_PASSWORD=

# --- Agente Negociador IA ----------------------------------------------
# Proveedor: mock | anthropic | openai | gemini
# mock = reglas + máquina de estados (no requiere internet ni API key). Si falta la clave del proveedor elegido, se usa mock.
LLM_PROVIDER=mock
# Modelo (vacío = por defecto: claude-opus-5-5 / gpt-4.1-mini / gemini-2.5-flash)
LLM_MODEL=
# Solo Claude: esfuerzo de razonamiento low | medium | high (más alto = más lento y costoso)
LLM_EFFORT=medium
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- WhatsApp vía OpenWA (proceso aparte en vendor/OpenWA) --------------
OPENWA_ENABLED=true
OPENWA_URL=http://localhost:2785
# Si se deja vacío se lee de vendor/OpenWA/data/.api-key
OPENWA_API_KEY=
OPENWA_SESSION_ID=inbestiga-demo
# (auto) secreto HMAC del webhook OpenWA -> app
OPENWA_WEBHOOK_SECRET=
# Números (con código de país, sin +) a los que el agente SÍ responde. Ej.: 51999000111,51999000222
WHATSAPP_ALLOWLIST=
# Frase con la que el estudiante inicia la conversación (el agente nunca escribe primero)
WHATSAPP_ACTIVATION_PHRASE=Hola, quiero información de asesoría de tesis

# --- Integración con BUYERS y PAYERS -----------------------------------
# (auto) token que BUYERS envía en Authorization: Bearer <token> al registrar un lead (POST /api/buyers)
BUYERS_TOKEN=
# (auto) token que PAYERS envía en Authorization: Bearer <token> al confirmar una contratación (POST /api/payers/confirmacion)
PAYERS_TOKEN=
# URL de PAYERS que recibe los acuerdos aceptados. Vacío = se registran aquí y se confirman con el simulador de PAYERS.
PAYERS_URL=
