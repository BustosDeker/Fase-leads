# =====================================================================
# INBESTIGA · Fase LEADS — configuración local
# `npm run setup` copia este archivo a .env y genera los secretos vacíos
# marcados con (auto). NUNCA subas .env al repositorio.
# =====================================================================

# --- Aplicación --------------------------------------------------------
PORT=3100
OPEN_BROWSER=true
# URL que usará n8n para llamar al backend local.
APP_URL=http://localhost:3100
# (auto) firma de las cookies de sesión
SESSION_SECRET=
# Usuarios de la UI: usuario:clave:rol separados por coma. Roles: admin, asesor, viewer.
# Cámbialos antes de una demo pública.
APP_USERS=admin:admin123:admin,asesor:asesor123:asesor,docente:docente123:viewer

# --- SQL Server (instalación nativa, sin Docker) -----------------------
DB_SERVER=localhost
DB_PORT=1433
# Solo si usas una instancia con nombre (p. ej. SQLEXPRESS) y SQL Server Browser está activo:
DB_INSTANCE=
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
# Usuario de la app con mínimos privilegios (lo crea `npm run db:init`)
DB_USER=inbestiga_app
# (auto)
DB_PASSWORD=
# Administrador: SOLO lo usa `npm run db:init` / `npm run seed` para crear bases y usuarios
DB_ADMIN_USER=sa
DB_ADMIN_PASSWORD=

# --- Enlaces de citas virtuales (opcionales; sala fija de empresa/asesor) --
# Si el medio elegido no tiene enlace configurado, la cita se agenda sin URL
# y el agente informa que el asesor lo enviará antes de la reunión.
CITA_ENLACE_GOOGLE_MEET=
CITA_ENLACE_ZOOM=

# --- Agente Negociador IA ----------------------------------------------
# Proveedor: mock | anthropic | openai | gemini | groq
# mock = reglas + máquina de estados (no requiere internet ni API key). Si falta la clave del proveedor elegido, se usa mock.
LLM_PROVIDER=groq
# Modelo (vacío = openai/gpt-oss-20b para Groq; admite tool use)
LLM_MODEL=
# Solo Claude: esfuerzo low | medium | high (Haiku 5.5 admite los tres; medium es el valor seguro)
LLM_EFFORT=medium
# Claude: fallback beta del servidor, desactivado por defecto porque requiere soporte vigente de la API.
LLM_ANTHROPIC_FALLBACK=false
# Costos aproximados oficiales de referencia: Haiku 5.5 desde US$0.10/M tokens entrada y US$0.50/M salida;
# Opus 5.5 US$4/M entrada y US$20/M salida. Pueden cambiar según modalidad, región y fecha.
# Gemini 2.5 Flash: capa gratuita disponible; tarifa pagada publicada: aprox. US$0.30/M entrada y US$2.50/M salida.
# PRIVACIDAD: en la cuota gratuita de Gemini, Google puede usar prompts y respuestas para mejorar productos.
# Usa únicamente datos ficticios en pruebas gratuitas; para datos reales usa un servicio pagado con sus condiciones.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
# URL oficial compatible con OpenAI.
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Groq Free tiene límites por organización y modelo (RPM/RPD/TPM/TPD); revisa Limits en la consola.
# Los valores pueden cambiar. La app respeta retry-after y reintenta 2 veces.
# PRIVACIDAD: Groq indica que las inferencias no se retienen por defecto, pero puede conservar
# entradas/salidas hasta 30 días para fiabilidad/abuso; puedes activar ZDR en Data Controls.
# No usa Customer Data para entrenar salvo permiso explícito. En pruebas usa datos ficticios.

# Agrupa mensajes consecutivos del estudiante antes de llamar al modelo.
# 4000 = 4 segundos; 0 desactiva el debounce.
AGENTE_DEBOUNCE_MS=4000
# Genera un resumen efímero cada N mensajes; nunca se guarda en la BD.
AGENTE_RESUMEN_CADA=20
# Máximo de turnos automáticos por conversación en una ventana móvil de una hora.
AGENTE_MAX_TURNOS_HORA=30

# --- Seguimiento proactivo LEADS ----------------------------------------
# (auto) Token Bearer para n8n o un proceso interno; `npm run setup` lo genera.
AGENTE_API_TOKEN=
# Horas desde el último mensaje del estudiante; máximo de intentos por oportunidad.
SEGUIMIENTO_HORAS=24,72
SEGUIMIENTO_MAX_INTENTOS=2
# false: n8n dispara el endpoint; true: scheduler interno.
SEGUIMIENTO_INTERNO=false
SEGUIMIENTO_CADA_MIN=15
# Solo habilitar para pruebas locales con `ahora` simulado.
AGENTE_PERMITIR_TIEMPO_SIMULADO=false
# false deriva con RIESGO_ABANDONO; true descarta automáticamente tras agotar intentos.
SEGUIMIENTO_DESCARTAR_AUTOMATICO=false

# --- WhatsApp vía OpenWA (proceso aparte en vendor/OpenWA) --------------
OPENWA_ENABLED=true
OPENWA_URL=http://localhost:2785
# Si se deja vacío se lee de vendor/OpenWA/data/.api-key
OPENWA_API_KEY=
OPENWA_SESSION_ID=inbestiga-demo
# (auto) secreto HMAC del webhook OpenWA -> app
OPENWA_WEBHOOK_SECRET=
# Números (con código de país, sin +) a los que el agente SÍ responde. Ej.: 51999000111,51999000222
WHATSAPP_ALLOWLIST=
# Frase con la que el estudiante inicia la conversación (el agente nunca escribe primero)
WHATSAPP_ACTIVATION_PHRASE=Hola, quiero información de asesoría de tesis
# Transcripción opcional de audios con Gemini. Desactivada por defecto; no guarda binarios.
TRANSCRIPCION_AUDIO=false

# --- Integración con BUYERS y PAYERS -----------------------------------
# (auto) token que BUYERS envía en Authorization: Bearer <token> al registrar un lead (POST /api/buyers)
BUYERS_TOKEN=
# (auto) token que PAYERS envía en Authorization: Bearer <token> al confirmar una contratación (POST /api/payers/confirmacion)
PAYERS_TOKEN=
# URL de PAYERS que recibe los acuerdos aceptados. Vacío = se registran aquí y se confirman con el simulador de PAYERS.
PAYERS_URL=
