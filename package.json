{
  "name": "inbestiga-leads",
  "version": "0.1.0",
  "private": true,
  "description": "INBESTIGA · Fase 2 LEADS (metodología IMPULSE): Agente Negociador IA, OLTP + data mart en SQL Server, ETL y tablero BI.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "start": "node scripts/start.js",
    "server": "tsx src/server/index.ts",
    "db:init": "node scripts/db-init.js",
    "db:reset": "node scripts/db-init.js --reset",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/web",
    "etl": "tsx src/etl/cli.ts",
    "etl:verify": "tsx src/etl/cli.ts --verificar",
    "seed": "tsx src/seed/cli.ts",
    "seed:reset": "tsx src/seed/cli.ts --reset",
    "test": "node --import tsx --test \"tests/*.test.ts\"",
    "db:informe": "node scripts/db-init.js --informe",
    "build": "vite build",
    "dev": "node scripts/dev.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.8.0",
    "@fastify/static": "8.0.3",
    "@fontsource/inter": "5.1.0",
    "@tanstack/react-query": "5.62.7",
    "dotenv": "16.4.7",
    "fastify": "5.2.0",
    "mssql": "11.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "recharts": "2.15.0",
    "tsx": "4.19.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/mssql": "9.1.5",
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.2",
    "vite": "5.4.11"
  }
}
