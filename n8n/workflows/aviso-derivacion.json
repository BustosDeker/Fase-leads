{
  "name": "INBESTIGA - Aviso de derivaciones pendientes",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "derivacion-schedule",
      "name": "Cada 5 minutos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        80,
        300
      ]
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "app-url",
              "name": "appUrl",
              "value": "http://127.0.0.1:3100",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "derivacion-config",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const estado = $getWorkflowStaticData('global');\nconst appUrl = $('Config').first().json.appUrl;\nconst desdeId = Number.isInteger(Number(estado.ultimoEscalamientoId)) ? Number(estado.ultimoEscalamientoId) : 0;\nreturn [{ json: { url: `${appUrl}/api/agente/derivaciones/pendientes?desde_id=${desdeId}` } }];"
      },
      "id": "derivacion-preparar",
      "name": "Preparar consulta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$json.url}}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "options": {
          "timeout": 30000
        }
      },
      "id": "derivacion-http",
      "name": "Consultar derivaciones",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "credentials": {
        "httpHeaderAuth": {
          "name": "INBESTIGA agente"
        }
      },
      "position": [
        600,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const estado = $getWorkflowStaticData('global');\nconst salida = $input.all();\nconst cuerpo = salida[0]?.json || {};\nif (Number.isInteger(Number(cuerpo.siguiente_desde_id))) estado.ultimoEscalamientoId = Number(cuerpo.siguiente_desde_id);\nreturn salida;"
      },
      "id": "derivacion-static-data",
      "name": "Guardar último escalamiento",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        820,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "hay-derivaciones",
              "leftValue": "={{($json.derivaciones || []).length}}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "derivacion-if",
      "name": "¿Hay derivaciones nuevas?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1060,
        300
      ]
    },
    {
      "parameters": {
        "fromEmail": "",
        "toEmail": "",
        "subject": "INBESTIGA: nueva derivación pendiente",
        "emailType": "text",
        "message": "={{JSON.stringify($json.derivaciones)}}"
      },
      "id": "derivacion-aviso",
      "name": "Aviso a persona (DESACTIVADO)",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "disabled": true,
      "position": [
        1320,
        220
      ]
    }
  ],
  "connections": {
    "Cada 5 minutos": {
      "main": [
        [
          {
            "node": "Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Config": {
      "main": [
        [
          {
            "node": "Preparar consulta",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Consultar derivaciones": {
      "main": [
        [
          {
            "node": "Guardar último escalamiento",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Guardar último escalamiento": {
      "main": [
        [
          {
            "node": "¿Hay derivaciones nuevas?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "¿Hay derivaciones nuevas?": {
      "main": [
        [
          {
            "node": "Aviso a persona (DESACTIVADO)",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Preparar consulta": {
      "main": [
        [
          {
            "node": "Consultar derivaciones",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {},
  "versionId": "inbestiga-derivaciones-v3",
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": []
}
